{
  "name": "@heygrady/hexagonoids-repo",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/heygrady/hexagonoids.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:demo": "turbo run build --filter=@heygrady/tictactoe-demo",
    "clean": "turbo run clean",
    "clean:hard": "turbo run clean --force && find . -name node_modules -type d -prune -exec rm -rf {} +",
    "check": "turbo run check",
    "claude": "yarn dlx @anthropic-ai/claude-code",
    "coverage": "turbo run coverage",
    "coverage:ci": "turbo run coverage --concurrency=2 -- --passWithNoTests --run",
    "demo": "turbo run build --filter=@heygrady/hexagonoids-demo... && yarn workspace @heygrady/hexagonoids-demo demo",
    "dev": "yarn workspace @heygrady/hexagonoids-app dev:workspace",
    "format": "turbo run format",
    "gemini": "yarn dlx @google/gemini-cli",
    "lint": "turbo run lint",
    "play": "yarn workspace @heygrady/tictactoe-demo play",
    "prepare": "husky",
    "preview": "yarn workspace @heygrady/hexagonoids-app preview",
    "release": "yarn build && changeset publish",
    "test": "turbo run test",
    "test:ci": "turbo run test --concurrency=2 -- --passWithNoTests --run",
    "vercel-build": "./scripts/inject-npm-auth.sh && yarn install && yarn build",
    "version": "changeset version && yarn install",
    "work-session": "node ../tone-studio/scripts/work-session/bin/index.js"
  },
  "packageManager": "yarn@4.12.0",
  "volta": {
    "node": "24.11.1",
    "npm": "11.6.4",
    "yarn": "4.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/config-workspace-scopes": "^20.0.0",
    "@manypkg/cli": "^0.25.1",
    "agent-browser": "^0.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.1.0",
    "turbo": "^2.6.1",
    "vercel": "^48.12.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,astro}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "resolutions": {
    "@neat-evolution/backprop": "portal:../../packages/backprop",
    "@neat-evolution/backprop-strategy": "portal:../../packages/backprop-strategy",
    "@neat-evolution/actor-critic": "portal:../../packages/actor-critic",
    "@neat-evolution/actor-critic-plugin": "portal:../../packages/actor-critic-plugin",
    "@neat-evolution/core": "portal:../../packages/core",
    "@neat-evolution/cppn": "portal:../../packages/cppn",
    "@neat-evolution/des-hyperneat": "portal:../../packages/des-hyperneat",
    "@neat-evolution/dataset-environment": "portal:../../packages/dataset-environment",
    "@neat-evolution/demo": "portal:../../packages/demo",
    "@neat-evolution/environment": "portal:../../packages/environment",
    "@neat-evolution/es-hyperneat": "portal:../../packages/es-hyperneat",
    "@neat-evolution/evaluation-strategy": "portal:../../packages/evaluation-strategy",
    "@neat-evolution/evaluator": "portal:../../packages/evaluator",
    "@neat-evolution/evolution": "portal:../../packages/evolution",
    "@neat-evolution/evolution-manager": "portal:../../packages/evolution-manager",
    "@neat-evolution/executor": "portal:../../packages/executor",
    "@neat-evolution/hyperneat": "portal:../../packages/hyperneat",
    "@neat-evolution/neat": "portal:../../packages/neat",
    "@neat-evolution/q-learning": "portal:../../packages/q-learning",
    "@neat-evolution/q-learning-plugin": "portal:../../packages/q-learning-plugin",
    "@neat-evolution/utils": "portal:../../packages/utils",
    "@neat-evolution/worker-actions": "portal:../../packages/worker-actions",
    "@neat-evolution/worker-evaluator": "portal:../../packages/worker-evaluator",
    "@neat-evolution/worker-pool": "portal:../../packages/worker-pool",
    "@neat-evolution/worker-reproducer": "portal:../../packages/worker-reproducer",
    "@neat-evolution/worker-rl": "portal:../../packages/worker-rl",
    "@neat-evolution/worker-threads": "portal:../../packages/worker-threads"
  }
}
